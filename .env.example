# Postgres URL, or pglite:<dir> for an embedded local database (e.g. pglite:.pglite)
DATABASE_URL=pglite:.pglite
PORT=3000
# Origin of the web app: CORS with credentials, trusted origin and passkey relying party.
WEB_ORIGIN=http://localhost:5173
# Better Auth. The secret is at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Resend, for sign-in codes.
EMAIL_API_KEY=
EMAIL_FROM=AMDB <code@example.com>
# Comma-separated addresses; an account created with one of them is an admin.
ADMIN_EMAILS=
