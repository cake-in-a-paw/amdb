# Postgres URL. Locally, `pnpm db:up` starts one in Docker (compose.yaml).
DATABASE_URL=postgres://postgres:postgres@localhost:55443/amdb
PORT=3000
# Proxies in front of the API that append to X-Forwarded-For (Railway's edge is one). The client
# address used for rate limits is that many entries from the right.
TRUSTED_PROXY_HOPS=1
# Origin of the web app: CORS with credentials, trusted origin and passkey relying party.
WEB_ORIGIN=http://localhost:5173
# Directory of the built web app, served by the API for every non-/api path. Leave unset in
# development (Vite serves the app). In production it is ../web/dist, relative to apps/api.
# WEB_DIST_DIR=../web/dist
# Better Auth. The secret is at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Resend, for sign-in codes.
EMAIL_API_KEY=
EMAIL_FROM=AMDB <code@example.com>
# TMDB v3 API key, for linked posters (optional; a secret, never logged). Unset means films and TV
# show placeholders.
TMDB_API_KEY=
# Comma-separated addresses; an account created with one of them is an admin.
ADMIN_EMAILS=
