{
  "name": "@amdb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./test/helpers/setup.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "import:wikidata": "tsx scripts/import-wikidata.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@amdb/shared": "workspace:*",
    "@better-auth/passkey": "1.7.13",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
