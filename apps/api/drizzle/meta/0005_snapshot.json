          "value": "CASE WHEN \"works\".\"release_day\" IS NULL THEN true\n        WHEN \"works\".\"release_year\" NOT BETWEEN 1 AND 9999 OR \"works\".\"release_month\" NOT BETWEEN 1 AND 12 THEN false\n        ELSE \"works\".\"release_day\" BETWEEN 1 AND extract(day FROM make_date(\"works\".\"release_year\", \"works\".\"release_month\", 1) + interval '1 month - 1 day') END"
